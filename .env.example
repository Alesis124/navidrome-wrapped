# Copia a .env y ajusta
# Red Docker de tu Navidrome (docker network ls)
NAVIDROME_NETWORK=navidrome_default

# Carpeta HOST con navidrome.db (el volumen que Navidrome monta en /data)
NAVIDROME_DATA_DIR=/opt/navidrome/data
# Carpeta HOST con la música (la misma que Navidrome monta en /music)
MUSIC_DIR_HOST=/mnt/musica

# La página pide el usuario y el año al entrar (cada persona escribe el suyo).
# Opcional: usuario por defecto SOLO para la API (/api/wrapped sin ?user=) y año por defecto (vacío = año actual)
NAVIDROME_USER=
WRAPPED_YEAR=

TZ=Europe/Madrid
# Debe poder leer la carpeta de datos y la música (mira: ls -ln /opt/navidrome/data)
PUID=1000
PGID=1000

WRAPPED_PORT=8100
CLIP_SECONDS=30

# Acceso a la BD: auto | direct | snapshot (ver README)
DB_ACCESS=auto
SNAPSHOT_TTL=60

# Tema por defecto (id de carpeta en ./themes o incluido: frecuencia).
# Vacío = el tema que se llame como el año (p. ej. «2026») y, si no existe, frecuencia.
# También se puede elegir por URL:  /?theme=frecuencia
WRAPPED_THEME=

# Clave para importar temas .zip desde la página (botón «Importar tema»). Un tema puede ejecutar
# JavaScript en el navegador de quien lo abra, por eso se pide clave. Vacío = importar desactivado.
# Genera una:  openssl rand -base64 18
ADMIN_KEY=
