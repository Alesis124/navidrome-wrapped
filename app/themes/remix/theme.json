    "--bg": "#111",
    "--fg": "#f3eee2",
    "--accent": "#ff5a1f"
  },
  "palette": [
    "#111111"
  ],
  "css": [
    "theme.css"
  ],
  "audio": {
    "enabled": true,
    "fade": 0.8
  },
  "slides": [
    {
      "type": "intro",
      "duration": 5200
    },
    "minutes",
    {
      "type": "top-artists",
      "duration": 8500
    },
    {
      "type": "race",
      "duration": 16500
    },
    "top-tracks",
    "number-one",
    "discoveries",
    "night",
    "hour",
    "months",
    "age",
    {
      "type": "outro",
      "duration": 6500
    }
  ],
