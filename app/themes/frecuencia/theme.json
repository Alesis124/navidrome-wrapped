{
  "name": "Frecuencia",
  "author": "Alesis",
  "version": "1.5.0",
  "description": "Tu año como una señal: los colores salen de cada carátula, la tipografía y el fondo respiran con la música, y cada cambio de diapositiva lanza una onda desde abajo.",
  "tokens": {
    "--bg": "#08070c",
    "--fg": "#f6f2ea",
    "--accent": "#ffb02e",
    "--font": "'Frecuencia Text', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "--display": "'Frecuencia Display', 'Arial Narrow', Impact, sans-serif",
    "--f-text": "'Frecuencia Text', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "--f-display": "'Frecuencia Display', 'Arial Narrow', Impact, sans-serif"
  },
  "palette": [
    "#4a1d3f",
    "#12385a",
    "#3a2a6b",
    "#0f4a43",
    "#6a2d12",
    "#1c2d6b"
  ],
  "fonts": [
    {
      "family": "Frecuencia Display",
      "src": "fonts/frecuencia-display.woff2",
      "weight": "500 900"
    },
    {
      "family": "Frecuencia Text",
      "src": "fonts/frecuencia-text.woff2",
      "weight": "400 800"
    }
  ],
  "css": [
    "theme.css",
    "wide.css"
  ],
  "script": "theme.js",
  "swiper": {
    "effect": "creative",
    "speed": 850,
    "creativeEffect": {
      "limitProgress": 1,
      "shadowPerProgress": true,
      "prev": {
        "translate": [
          0,
          "-22%",
          -1
        ],
        "scale": 0.92,
        "opacity": 0,
        "shadow": true
      },
      "next": {
        "translate": [
          0,
          "100%",
          0
        ]
      }
    }
  },
  "audio": {
    "enabled": true,
    "fade": 1.2
  },
  "slides": [
    {
      "type": "intro",
      "duration": 5200
    },
    {
      "type": "minutes",
      "duration": 7000
    },
    {
      "type": "race",
      "duration": 17500
    },
    {
      "type": "top-tracks",
      "duration": 8000
    },
    {
      "type": "number-one",
      "duration": 8500
    },
    {
      "type": "discoveries",
      "duration": 7000
    },
    {
      "type": "age",
      "duration": 8200
    },
    {
      "type": "hour",
      "duration": 7500
    },
    {
      "type": "night",
      "duration": 7000
    },
    {
      "type": "loop",
      "duration": 6500
    },
    {
      "type": "repeat",
      "duration": 6500
    },
    {
      "type": "outro",
      "duration": 7500
    },
    {
      "type": "collage",
      "duration": 60000
    }
  ],
  "strings": {
