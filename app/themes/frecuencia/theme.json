    "hours_short": "h",
    "intro_lead": "El año de {user}",
    "intro_line": "Así sonó.<br>Sube el volumen.",
    "minutes_lead": "Este año le diste al play durante",
    "minutes_unit": "minutos",
    "minutes_note": "Eso es el <b data-fx=\"pct\"></b> de tu año: unos <b data-fx=\"span\"></b> de música sin parar.",
    "minutes_detail": "{plays} reproducciones, {artists} artistas y {tracks} canciones distintas.",
    "artists_lead": "Los que más sonaron",
    "artists_unit": "escuchas",
